# ── 필수 ────────────────────────────────────────────────
# PostgreSQL 접속 정보 (Neon / Supabase / 자체 서버 등)
DATABASE_URL="postgresql://user:password@localhost:5432/rankradar?schema=public"

# 세션 JWT 서명 키. 반드시 32자 이상 랜덤 문자열로 교체할 것
# 생성 예: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# 배치 수집 API(/api/cron/collect) 호출용 비밀키
# 생성 예: openssl rand -hex 32
CRON_SECRET="change-me-cron-secret"

# ── 검색엔진 API (없으면 데모 모드로 동작) ──────────────
# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 카카오 developers > 앱 > REST API 키 (다음 검색)
KAKAO_REST_API_KEY=""

# 구글 Programmable Search Engine
GOOGLE_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# ── 선택 ────────────────────────────────────────────────
# 회원가입 허용 여부 (false 로 두면 초대/수동 등록만 가능)
ALLOW_SIGNUP="true"
